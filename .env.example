PORT=4000

# postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/email_scheduler

# redis
REDIS_URL=redis://localhost:6379

# elasticsearch (OPTIONAL - leave blank to disable search, app still runs)
ELASTIC_URL=http://localhost:9200

# set true to run the worker inside the api process (single-service deploy).
# leave false locally and run `npm run worker` separately.
RUN_WORKER=false

# worker tuning
WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# google (used to verify id tokens on the api)
GOOGLE_CLIENT_ID=

# slack oauth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/slack/callback

FRONTEND_URL=http://localhost:3000

# bull board dashboard login
ADMIN_USER=admin
ADMIN_PASS=admin
